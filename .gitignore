# OS cruft (Windows)
Thumbs.db
desktop.ini

# VS Code local-only overrides (continue-config/ itself is intentionally tracked)
.vscode/

# Visual Studio's per-solution cache folder
.vs/

# AutoCAD lock, autosave, and backup files
*.dwl
*.dwl2
*.bak
*.sv$

# PowerShell provisioning logs / diagnostics output
provisioning/logs/
provisioning/diagnostics/

# Self-test output. The report is published to the vm-reports branch by
# verification/Publish-LabReport.ps1, never committed on a source branch.
verification/out/
